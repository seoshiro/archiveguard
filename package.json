{
  "name": "archiveguard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "build": "tsc -b && vite build && node scripts/write-release-info.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "fflate": "0.8.3",
    "piexifjs": "1.0.6",
    "exifr": "7.1.3",
    "lucide-react": "1.49.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.3",
    "vitest": "5.0.3",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "@playwright/test": "1.63.0",
    "jpeg-js": "0.4.4"
  }
}
